       <div class="container-fluid">

        <div class="loginContainer">
            <span class="form-horizontal"id="loginForm" >
                <div class="form-row row-fluid">
                  <%= content_tag :h3, display_flash_messages %>
                    <% form_for :user, @user, :url => { :action => :authenticate } do |f| %>
    <p>
      <%= f.label :email, "Email:" %>
      <%= f.text_field :email, :size => 40 %>
      <%= display_error_messages(@user, :email) %>
    </p>
    <p>
      <%= f.label :password, "Password:" %>
      <%= f.password_field :password, :size => 40 %>
      <%= display_error_messages(@user, :password) %>
    </p>
    <p>
      <%= submit_tag "Login" %>
    </p>
  <% end %>
     <br />Don't have an account? <%= link_to "Create one.", :controller => :users, :action => :new %>                              
                  
                  <ol>
   <% if !logged_in? %>
     <li>
       <h2><%= link_to "Login", :controller => :users, :action => :login %> to the apps on this cloud.</h2>
     </li>
   <% end %>

   <li>
     <h2><%= link_to "Create", :controller => :users, :action => :new %> an account on this cloud.</h2>
   </li>            

   <% if logged_in? %>
     <li>
       <h2><%= link_to "Logout", :controller => :users, :action => :logout %> from your current account.</h2>
     </li>
   <% end %>

   <li>
     <h2>See the <%= link_to "status", :controller => :status, :action => :cloud %> of this instance.</h2>
   </li>

   <% if is_user_cloud_admin %>
     <li>
       <h2>View <%= link_to "monitoring data", monitoring_url %> for this instance.</h2>
     </li>
     <li>
       <h2><%= link_to "Manage", :controller => :authorize, :action => :cloud %> permissions for this instance.</h2>
     </li>
   <% end %>

  </ol>

                </div>

            </span>
        </div>

    </div><!-- End .container-fluid -->