   <div class="container-fluid">

        <div class="loginContainer">
            <span class="form-horizontal"  id="loginForm" >
                <% form_for :user, @user, :url => { :action => :create }  do |f| %>
                <div class="form-row row-fluid">
                    <div class="span12">
                        <div class="row-fluid">
                        <%= f.label :email, "Email:" %>
                        <%= f.text_field :email, :size => 40 %>
                        <%= display_error_messages(@user, :email) %>
                        </div>
                    </div>
                </div>

                <div class="form-row row-fluid">
                    <div class="span12">
                        <div class="row-fluid">
                          <%= f.label :password, "Password:" %>
                          <%= f.password_field :password, :size => 40 %>
                          <%= display_error_messages(@user, :password) %>
                        </div>
                    </div>
                </div>
                <div class="form-row row-fluid">
                    <div class="span12">
                        <div class="row-fluid">
                          <%= f.label :password_confirmation, "Password Confirmation:" %>
                          <%= f.password_field :password_confirmation, :size => 40 %>
                          <%= display_error_messages(@user, :password_confirmation) %>
                        </div>
                    </div>
                </div>
                <div class="form-row row-fluid">                       
                    <div class="span12">
                        <div class="row-fluid">
                            <div class="form-actions">
                            <div class="span12 controls">
                                <%= submit_tag "Create" %>
                                  <% end %>
                                  <br />Already have an account? <%= link_to "Login.", :action => :login %>
                            </div>
                            </div>
                        </div>
                    </div> 
                </div>

            </span>
        </div>

    </div><!-- End .container-fluid -->